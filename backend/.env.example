# Copia este archivo como .env para trabajar en local. En Railway se ponen en "Variables".
DATABASE_URL="postgresql://usuario:password@localhost:5432/ciberico?schema=public"
JWT_SECRET="pon-aqui-una-clave-larga-y-aleatoria"
FRONTEND_URL="http://localhost:5173"
PORT=3001

# Carpeta de subidas. En Railway: monta un Volume en /data y pon UPLOAD_DIR=/data/uploads
UPLOAD_DIR="./uploads"

# Cuenta de presidencia (se crea/actualiza al arrancar)
ADMIN_EMAIL="ibericocaballo@gmail.com"
ADMIN_PASSWORD="cambia-esta-contraseña"

# IA principal (API compatible con OpenAI). Ejemplos:
#   Claude: AI_BASE_URL="https://api.anthropic.com/v1"  AI_MODEL="claude-sonnet-5"
#   Kimi:   AI_BASE_URL="https://api.moonshot.ai/v1"    AI_MODEL="kimi-k2.6"
AI_BASE_URL="https://api.anthropic.com/v1"
AI_API_KEY=""
AI_MODEL="claude-sonnet-5"
# Segunda IA opcional (doble lectura)
AI2_BASE_URL=""
AI2_API_KEY=""
AI2_MODEL=""
AI_VIDEO_FRAMES=8
AI_VIDEO_BURSTS=2

# Precio de la pre-valoración en euros (0 = gratis)
PREVALORACION_PRICE_EUR=0

# Stripe (opcional; sin clave, las gestiones quedan en "pendiente de pago")
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
